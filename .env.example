# Copy to .env.local for the Next.js app. Never commit this file or expose server secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase service role key is server-only; never prefix it with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key used to encrypt publishing webhook bearer secrets.
DANTE_INTEGRATION_ENCRYPTION_KEY=

# Supabase Project URL and publishable key (safe to use with Auth + RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical deployment URL, e.g. https://dante.vercel.app
NEXT_PUBLIC_APP_URL=
