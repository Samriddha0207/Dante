# Copy to .env.local for the Next.js app. Never commit this file or expose server secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase Project URL and publishable key (safe to use with Auth + RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical deployment URL, e.g. https://dante.vercel.app
NEXT_PUBLIC_APP_URL=
